# Copy to .env and fill in. Never commit .env.

# Claude Agent SDK auth (required to run the agent loop).
ANTHROPIC_API_KEY=

# LIVE-TRADING SAFETY INTERLOCK.
# Leave UNSET (or 0) for paper trading. To trade the live account you must set this to 1
# AND set account.mode: live in config.yaml. Both are required; either alone stays paper.
IBKR_ALLOW_LIVE=

# Optional: override the config file path.
# IBKR_AGENT_CONFIG=config.yaml

# Optional: also deliver the daily brief to a Telegram chat (in addition to the Claude chat
# + push). BOTH must be set to enable it; leave blank to disable. See docs/RUNNING.md §8.
#   1. Create a bot: message @BotFather -> /newbot -> copy the token below.
#   2. Message your new bot ONCE (bots can't message you first), then read your chat id from
#      https://api.telegram.org/bot<token>/getUpdates
#   3. IMPORTANT for the SCHEDULED bot: set these two vars in the Routine's ENVIRONMENT (not
#      just this local .env), AND allowlist the host `api.telegram.org` in that environment's
#      network settings. The bot posts to Telegram with a direct HTTPS call, so without the
#      allowlist the scheduled run gets a proxy 403 even with a valid token/chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
