# Copy to .env and fill in. Never commit .env.

# Claude Agent SDK auth (required to run the agent loop).
ANTHROPIC_API_KEY=

# LIVE-TRADING SAFETY INTERLOCK.
# Leave UNSET (or 0) for paper trading. To trade the live account you must set this to 1
# AND set account.mode: live in config.yaml. Both are required; either alone stays paper.
IBKR_ALLOW_LIVE=

# Optional: override the config file path.
# IBKR_AGENT_CONFIG=config.yaml

# Optional: also deliver the daily brief to a Telegram chat (in addition to the Claude chat
# + push). BOTH must be set to enable it; leave blank to disable. See docs/RUNNING.md.
#   1. Create a bot: message @BotFather -> /newbot -> copy the token below.
#   2. Message your new bot once, then read your chat id from
#      https://api.telegram.org/bot<token>/getUpdates
# For the SCHEDULED bot, set these in the Routine's environment too, not just locally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
